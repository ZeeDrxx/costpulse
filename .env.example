# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=costpulse.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://costpulse.example.com
